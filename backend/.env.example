# Base de dades PostgreSQL (Neon.tech, Supabase, Render Postgres o local)
# Exemple Neon/Supabase: postgresql://user:password@ep-cool-fog-123456.eu-central-1.neon.tech/campus_db?sslmode=require
DATABASE_URL=postgresql://murense_user:password@localhost:5432/campus_db

# Clau secreta per a la generació de tokens JWT
SECRET_KEY=canvia_aquesta_clau_secreta_per_a_produccio_o_demo_segura_123456

# Contrasenya inicial de l'usuari admin (admin@cdmurense.com)
ADMIN_DEFAULT_PASSWORD=ClaveInicialSegura2027!

# Orígens permesos per a CORS (separats per coma)
# ALLOWED_ORIGINS=https://campus-murense.vercel.app,http://localhost:5173

# URL base de l'aplicació web (usada per a generar els enllaços d'edició d'inscripcions als emails)
APP_URL=http://localhost:5173

# --- Servei de Correu Electrònic (Resend o SMTP Gmail) ---
# Opció A: Resend (Recomanat per senzillesa i quota gratuïta)
# RESEND_API_KEY=re_123456789_abcdef
# RESEND_FROM_EMAIL=Campus C.D. Murense <campus@teudomini.com>

# Opció B: SMTP Natiu de Google / Gmail amb Contrasenya d'Aplicació (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=campuscdmurense@gmail.com
# Genera una Contrasenya d'Aplicació a: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=teva_contrasenya_aplicacio_de_16_caracters
EMAIL_FROM=Campus C.D. Murense <campuscdmurense@gmail.com>

# Carregar automàticament alumnes i dades de prova si la base de dades és buida
AUTO_SEED=true
