# ==============================================================================
# .gitignore — Campus C.D. Murense (Vercel + Supabase Stack)
# ==============================================================================

# ── Variables d'Entorn & Secrets (Credencials Privades) ──────────────────────
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
secrets.json
service-account*.json

# Permet explícitament els fitxers de plantilla d'exemple
!.env.example
!*.example

# ── Node / Frontend (Vite & Vercel) ──────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
.vercel/
*.local

# ── Python / Caches / Dades Locals ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
env/
venv/
.venv/
*.sqlite3
*.db
campus.db

# ── Logs & Debugging ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Sistema Operatiu & IDEs ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
