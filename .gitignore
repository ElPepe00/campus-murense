# ============================================================
# .gitignore — Campus C.D. Murense
# ============================================================

# ── Variables d'entorn (secrets) ────────────────────────────
.env
.env.local
.env.*.local
# Permet fitxers d'exemple (sense secrets reals)
!.env.example
!*.example

# ── Python / Backend ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# SQLite local (dades de dev, no de producció)
*.sqlite3
*.db
campus.db

# ── Base de dades local Docker ───────────────────────────────
postgres_data/

# ── Node / Frontend ──────────────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
*.local

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Sistema operatiu ─────────────────────────────────────────
.DS_Store
Thumbs.db
